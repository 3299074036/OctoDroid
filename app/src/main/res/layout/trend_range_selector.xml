<?xml version="1.0" encoding="utf-8"?>
<!-- 0.5.0 时间范围选择行：不再是右上角工具栏菜单，改为趋势列表上方的
     选择行（位于顶部 Tab 下方、列表第一行之前，以 Adapter header 形式挂在
     列表顶部）。三选项与原对话框同一数据源与筛选逻辑。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/content_padding"
    android:paddingEnd="@dimen/content_padding"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?android:colorBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trend_range"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/trend_range_today"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/trend_today"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <TextView
        android:id="@+id/trend_range_week"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/trend_week"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <TextView
        android:id="@+id/trend_range_month"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/trend_month"
        android:textAppearance="?android:attr/textAppearanceSmall" />

</LinearLayout>
