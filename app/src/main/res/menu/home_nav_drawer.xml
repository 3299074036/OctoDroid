            android:title="@string/release_radar"
            android:icon="@drawable/icon_star"/>
        <item
            android:id="@+id/star_groups"
            android:title="@string/star_groups"
            android:icon="@drawable/folder"/>
        <item
            android:id="@+id/recent_history"
            android:title="@string/recent_history"
            android:icon="@drawable/icon_history"/>
        <item
            android:id="@+id/my_issues"
            android:title="@string/my_issues"
            android:icon="@drawable/icon_issues"/>
        <item
            android:id="@+id/my_prs"
            android:title="@string/my_pull_requests"
            android:icon="@drawable/icon_pull_request"/>
