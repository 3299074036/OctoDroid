            android:id="@+id/theme_toggle"
            android:title="@string/theme_toggle"
            android:icon="@drawable/icon_theme"
            android:checkable="false"
            app:actionLayout="@layout/theme_toggle" />
    </group>
    <group android:id="@+id/account"
           android:checkableBehavior="none"
           android:visible="false">
        <item
            android:id="@+id/profile"
            android:title="@string/my_profile"
            android:icon="@drawable/profile" />
        <item
            android:id="@+id/logout"
            android:title="@string/logout"
            android:icon="@drawable/logout" />
    </group>
    <group android:id="@+id/other_accounts"
           android:checkableBehavior="none"
           android:visible="false">
        <item
            android:id="@+id/add_account"
            android:title="@string/add_account"
            android:icon="@drawable/icon_add"
            android:orderInCategory="9999" />
