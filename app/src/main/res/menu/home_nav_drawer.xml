            android:id="@+id/my_gists"
            android:title="@string/my_gists"
            android:icon="@drawable/icon_gists"/>
    </group>
    <!-- 一级：发现 -->
    <group
        android:id="@+id/explore"
        android:checkableBehavior="single">
        <item
            android:id="@+id/pub_timeline"
            android:title="@string/pub_timeline"
            android:icon="@drawable/icon_timeline" />
        <item
            android:id="@+id/trend"
            android:title="@string/trend"
            android:icon="@drawable/icon_trending"/>
        <item
            android:id="@+id/topic_discovery"
            android:title="@string/topic_discovery"
            android:icon="@drawable/tag"/>
        <item
            android:id="@+id/blog"
            android:title="@string/blog"
            android:icon="@drawable/icon_github"/>
    </group>
    <!-- 一级：工具 -->
    <group
        android:id="@+id/navigation"
        android:checkableBehavior="single">
        <item
            android:id="@+id/search"
            android:title="@string/search"
            android:icon="@drawable/icon_search"/>
    </group>
