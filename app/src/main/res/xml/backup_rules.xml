<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-7 (Android 12+): 本应用 targetSdk 35，Android 12+ 设备上系统
     只认 dataExtractionRules，不认 fullBackupContent；没有本文件时
     12+ 设备会按默认规则备份全部数据（含两个数据库），光改
     backup_descriptor.xml 等于没改。因此这里与 backup_descriptor.xml
     用同一排除清单。只写 <exclude>，其余域保持默认备份状态不变
     （shared_prefs 不新增也不删除）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gh4adb.db" />
        <exclude domain="database" path="suggestions.db" />
        <!-- 83：WorkManager 调度库（任务规格/定时，无凭据），不随系统备份上云。 -->
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <!-- 0.1.20 F-04: Android 12+ 未排除即备份。默认偏好（翻译密钥在内）
             与加密偏好及其明文回退文件一律不随系统自动备份上传。
             默认偏好文件名随 applicationId 而变，debug/release 两名都排除。 -->
        <exclude domain="sharedpref" path="com.gh4a_preferences.xml" />
        <exclude domain="sharedpref" path="com.gh4a.debug_preferences.xml" />
        <exclude domain="sharedpref" path="Gh4a-secure.xml" />
        <exclude domain="sharedpref" path="Gh4a-secure-plain.xml" />
        <!-- 0.2.2（S-M2）：以下 shared_prefs 含账号／私有数据，一并排除。
             recent_history_&lt;login&gt;、star_groups_&lt;login&gt; 与
             star_list_order_&lt;login&gt; 是按登录名分文件的，备份规则不
             支持通配符、无法枚举，只能靠文件本身不在排除清单外——这三个
             文件仍会随备份走，请勿在其中存敏感内容。 -->
        <exclude domain="sharedpref" path="Gh4a-pref.xml" />
        <exclude domain="sharedpref" path="drawer_config.xml" />
        <exclude domain="sharedpref" path="download_records.xml" />
        <exclude domain="sharedpref" path="user_lists_cache.xml" />
        <exclude domain="sharedpref" path="radar_cache.xml" />
        <exclude domain="sharedpref" path="release_radar_notify.xml" />
        <exclude domain="sharedpref" path="hot_repos_cache.xml" />
        <exclude domain="sharedpref" path="me_header_cache.xml" />
        <exclude domain="sharedpref" path="star_update_read.xml" />
        <!-- 108：file 域（files/）默认随系统自动备份上云；诊断日志
             （diagnostic/，含 diag-trace.txt 与 crash-*.txt）与商店
             feed 缓存（store-cache/）不应占备份配额。 -->
        <exclude domain="file" path="diagnostic/" />
        <exclude domain="file" path="store-cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="gh4adb.db" />
        <exclude domain="database" path="suggestions.db" />
        <!-- 83：WorkManager 调度库（任务规格/定时，无凭据），不随系统备份上云。 -->
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="sharedpref" path="com.gh4a_preferences.xml" />
        <exclude domain="sharedpref" path="com.gh4a.debug_preferences.xml" />
        <exclude domain="sharedpref" path="Gh4a-secure.xml" />
        <exclude domain="sharedpref" path="Gh4a-secure-plain.xml" />
        <exclude domain="sharedpref" path="Gh4a-pref.xml" />
        <exclude domain="sharedpref" path="drawer_config.xml" />
        <exclude domain="sharedpref" path="download_records.xml" />
        <exclude domain="sharedpref" path="user_lists_cache.xml" />
        <exclude domain="sharedpref" path="radar_cache.xml" />
        <exclude domain="sharedpref" path="release_radar_notify.xml" />
        <exclude domain="sharedpref" path="hot_repos_cache.xml" />
        <exclude domain="sharedpref" path="me_header_cache.xml" />
        <exclude domain="sharedpref" path="star_update_read.xml" />
        <!-- 108：与 cloud-backup 同一清单，device-transfer 也排除
             诊断日志与商店缓存。 -->
        <exclude domain="file" path="diagnostic/" />
        <exclude domain="file" path="store-cache/" />
    </device-transfer>
</data-extraction-rules>
