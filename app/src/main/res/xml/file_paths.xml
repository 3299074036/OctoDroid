<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 77：仍暴露公共 Download/，只为兼容 0.2.2 之前下载到公共 Downloads/
         的旧记录（DownloadListFragment 有回落分支）。文件名写入时已消毒，
         无 ../ 穿越。TODO(2027-01)：0.2.2 之前（2026-10-14 前）的旧记录
         基本消亡后，删掉本条 external-path 与 DownloadListFragment 的
         公共目录回落分支。 -->
    <external-path
        name="download"
        path="Download/" />
    <!-- 0.2.2（S-M5）：下载改落应用私有目录（getExternalFilesDir/Download），
         FileProvider 在此开一个口，供下载列表／自更新安装打开文件。 -->
    <external-files-path
        name="private_download"
        path="Download/" />
    <!-- 78：只放行诊断导出子目录 diag-export/（DiagnosticLogActivity 分享用）；
         旧写法 path="diag-export.txt" 把导出文件本身配成根，文件路径 == 根路径，
         getUriForFile 会 substring 越界；path="." 则暴露整个 cacheDir（含
         OkHttp 缓存、last_crash.txt），0.2.2 特意收窄过。last_crash.txt 只供
         应用内读，不走 FileProvider。 -->
    <cache-path
        name="trace"
        path="diag-export/" />
</paths>
